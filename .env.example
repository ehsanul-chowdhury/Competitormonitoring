# Copy to .env.local and fill in. These values are placeholders, not real secrets.

# ---------- Database ----------
DATABASE_URL=postgresql://user:password@localhost:5432/competitor_intel
DIRECT_URL=postgresql://user:password@localhost:5432/competitor_intel

# ---------- Better Auth ----------
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-32-byte-random-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Google sign-in (optional) ----------
# The "Continue with Google" button renders only when both are set, so the app
# never shows a sign-in button that cannot work.
#
# To create them:
#   1. https://console.cloud.google.com  ->  create/select a project
#   2. APIs & Services -> OAuth consent screen -> External -> fill app name +
#      support email -> add your Google account under "Test users"
#   3. APIs & Services -> Credentials -> Create credentials
#      -> OAuth client ID -> Application type: "Web application"
#   4. Under "Authorized redirect URIs" add EXACTLY:
#         http://localhost:3000/api/auth/callback/google
#      (add your production URL later, same /api/auth/callback/google path)
#   5. Copy the generated Client ID and Client secret below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Transactional email (optional) ----------
# Used to send the "verify your email" link on sign-up. Without a key, the
# app doesn't fail — it just prints the email (and the verification link) to
# the server console instead, so local dev works with zero setup.
#
# To create one:
#   1. https://resend.com  ->  sign up  ->  API Keys -> Create API Key
#   2. For local dev, Resend's shared test domain works out of the box:
#      leave EMAIL_FROM unset and it defaults to onboarding@resend.dev.
#   3. For production, verify your own sending domain in Resend and set
#      EMAIL_FROM to an address on it, e.g. "IntelFlock <noreply@yourdomain.com>".
RESEND_API_KEY=
EMAIL_FROM=

# ---------- Scan pipeline ----------
STORAGE_DIR=./storage/snapshots
AVATAR_DIR=./storage/avatars
SCAN_FANOUT_INTERVAL_MS=300000

# ---------- Nest API backend (apps/api) ----------
# The Next.js app proxies all business-data requests to the Nest service.
# INTERNAL_API_SECRET must be identical here and in apps/api/.env — it signs
# the short-lived JWT this app mints per request to prove the caller's
# identity to Nest. Generate with: openssl rand -base64 32
NEST_API_URL=http://localhost:4100
INTERNAL_API_SECRET=replace-with-a-32-byte-random-secret
