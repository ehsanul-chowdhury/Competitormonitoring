# Copy to .env and fill in. These values are placeholders, not real secrets.

# Same Postgres database as the root Next.js app (../../.env.local) — this
# service generates its own Prisma Client from prisma/schema.prisma but never
# runs migrations; the Next.js app's prisma/migrations stays the source of
# truth for schema changes.
DATABASE_URL=postgresql://user:password@localhost:5432/competitor_intel

PORT=4100

# Redis for the BullMQ scan queue. Run locally with:
#   docker compose up -d redis
REDIS_URL=redis://localhost:6379

# Must match INTERNAL_API_SECRET in the root Next.js app's .env.local —
# verifies the per-request JWT Next.js mints after checking the user's
# session. Generate with: openssl rand -base64 32
INTERNAL_API_SECRET=replace-with-a-32-byte-random-secret

# Same snapshot directory the scan pipeline has always used, one level up
# from here so both services agree on the same files during the migration.
STORAGE_DIR=../../storage/snapshots

# How often the scan scheduler looks for due pages, in milliseconds.
SCAN_FANOUT_INTERVAL_MS=300000

# Optional — enables real AI-generated change analysis and the AI assistant
# chat. Without it, both honestly fall back to deterministic/placeholder text.
DEEPSEEK_API_KEY=
